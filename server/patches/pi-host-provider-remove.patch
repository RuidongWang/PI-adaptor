+    stdin: Readable.from([typeof payload === "string" ? payload : JSON.stringify(payload)]),
+    stdout: new Writable({ write(chunk, _encoding, done) { stdout += String(chunk); done(); } }),
+  });
+  return { code, stdout };
+}
