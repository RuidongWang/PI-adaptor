+import { parseArgs, resolveConfig } from "./config.js";
+
+/**
+ * `pi-host [<subcommand>] [--data-dir <dir>] [--port <n>] [--pair] [--host-core <bin>] [--sidecar <entry>]`
+ *
+ * stdout carries exactly the lines a bootstrap script parses:
+ *   PI_HOST_READY {"hostId":..,"port":..,"version":..}
+ *   PI_HOST_PAIRING_TOKEN {"token":..,"expiresAt":..}   (with --pair)
+ *   PI_HOST_<OP> {..}                                   (subcommand results)
+ *   PI_HOST_FAILED {"code":..}                          (any subcommand failure)
+ * Everything else is structured stderr.
+ */
+
+export type CliIo = { stdin: NodeJS.ReadableStream; stdout: NodeJS.WritableStream };
+
+/**
+ * Every subcommand is one SSH exec: one bounded stdin line in, one stdout line
+ * out. The help block lists them one per line so a client can prove support by
+ * matching the whole token (§9.1); an unknown subcommand must never fall through
+ * to the Host start path (§9.2, T-06).
+ */
+const SUBCOMMANDS: ReadonlyArray<{ name: string; help: string; run: (argv: string[], io: CliIo) => Promise<number> }> = [
+  {
+    name: CLI_PROVIDER_IMPORT,
+    help: "import selected providers from SSH stdin",
+    run: async (argv, io) => (await import("./provider-import.js")).runProviderImport(argv, io),
+  },
+  {
+    name: CLI_PROVIDER_REMOVE,
+    help: "delete one provider from SSH stdin",
+    run: async (argv, io) => (await import("./provider-remove.js")).runProviderRemove(argv, io),
+  },
+  {
+    name: CLI_PROVIDER_BINDING_STATUS,
+    help: "report a session's model binding and its availability",
+    run: async (argv, io) => (await import("./provider-remove.js")).runProviderBindingStatus(argv, io),
+  },
+  {
+    name: CLI_PROVIDER_REMOVE_STATUS,
+    help: "report the observed removal state of one provider",
+    run: async (argv, io) => (await import("./provider-remove.js")).runProviderRemoveStatus(argv, io),
+  },
+  {
+    name: CLI_PROVIDER_SYNC_FORGET,
+    help: "drop the import receipt of one provider",
+    run: async (argv, io) => (await import("./provider-remove.js")).runProviderSyncForget(argv, io),
+  },
+];
+
+/** One line per subcommand; leading spaces are allowed, the token must match exactly. */
+export function helpText(): string {
+  return [
+    "pi-host — headless PI Agent Host (RACP-WS on loopback)",
+    ...SUBCOMMANDS.map((entry) => `  ${entry.name.padEnd(24)}${entry.help}`),
+    "",
+    "  --data-dir <dir>          host data directory (default ~/.pi-desktop)",
+    "  --port <n>                loopback port (default 0 = pick free)",
+    "  --host <addr>             bind address; loopback only",
+    "  --pair                    print a single-use pairing token at start",
+    "  --pairing-lifetime-ms <n> pairing token lifetime (default 600000)",
+    "  --host-core <path>        pi-desktop-host-core binary",
+    "  --sidecar <path>          agent sidecar entry",
+    "  --browse-root <dir>       folder-picker root (default home)",
+    "  --log-level <level>       info | warn | error",
+    "",
+  ].join("\n");
+}
+
+/**
+ * Resolves to the process exit code. A leading token that is not a flag is a
+ * subcommand: a known one runs, an unknown one is refused here — it must never
+ * reach `resolveConfig`, where it used to be skipped and started a Host.
+ */
+export async function runCli(argv: string[], io: CliIo = process): Promise<number> {
+  const first = argv[0];
+  if (first !== undefined && !first.startsWith("-")) {
+    const subcommand = SUBCOMMANDS.find((entry) => entry.name === first);
+    if (!subcommand) {
+      io.stdout.write(`${FAILED_PREFIX} ${JSON.stringify({ code: "INVALID_REQUEST" })}\n`);
+      return 1;
+    }
+    return subcommand.run(argv.slice(1), io);
+  }
+  const args = parseArgs(argv);
+  if (args.help === true) {
+    io.stdout.write(helpText());
+    return 0;
+  }
+  await startHost(args);
+  return 0;
+}
+
+async function startHost(args: ReturnType<typeof parseArgs>): Promise<void> {
+  const config = resolveConfig(args);
+  const { startPiHost } = await import("./app.js");
+  const app = await startPiHost(config);
+  process.stdout.write(`PI_HOST_READY ${JSON.stringify({ hostId: app.hostId, host: app.address.host, port: app.address.port, version: (await import("@pi-desktop/shared")).APP_VERSION })}\n`);
+  if (config.pair) {
+    const pairing = await app.issuePairingToken(config.pairingLifetimeMs);
+    process.stdout.write(`PI_HOST_PAIRING_TOKEN ${JSON.stringify(pairing)}\n`);
+  }
+  const stop = (signal: string) => {
+    app.log("info", "signal received", { signal });
+    void app.stop().finally(() => process.exit(0));
+  };
+  process.once("SIGINT", () => stop("SIGINT"));
+  process.once("SIGTERM", () => stop("SIGTERM"));
+  process.on("unhandledRejection", (reason) => {
+    app.log("error", "unhandled rejection", { error: reason instanceof Error ? reason.stack ?? reason.message : String(reason) });
+  });
+  process.on("uncaughtException", (error) => {
+    app.log("error", "uncaught exception", { error: error.stack ?? error.message });
+  });
+}
