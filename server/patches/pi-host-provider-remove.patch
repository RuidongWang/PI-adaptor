+  const keys = Object.keys(request);
+  if (keys.length !== 2 || !keys.includes("op") || !keys.includes("payload")) throw new ImportFailure("INVALID_REQUEST");
+  const op = (request as { op: unknown }).op;
+  // A misspelled op is a client bug, never a capability answer (§2.4.4, T-39).
+  if (typeof op !== "string" || !(ADMIN_OPS as readonly string[]).includes(op)) throw new ImportFailure("INVALID_REQUEST");
+  return { op: op as AdminOp, payload: (request as { payload: unknown }).payload };
