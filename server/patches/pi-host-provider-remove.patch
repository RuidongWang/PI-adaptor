+export type AdminOperationResult = { ok: true; value: unknown } | { ok: false; code: AdminFailureCode };
+
+/**
+ * Client for the four removal ops.
+ *
+ * §7.2: a failure that happens *before* the frame is written is
+ * `ADMIN_UNAVAILABLE` (nothing was executed); anything after it is either the
+ * server's own code or `RESULT_UNKNOWN`/`RESPONSE_*` — never "not executed".
+ */
+export async function sendAdminOperation(dataDir: string, op: AdminOp, payload: unknown): Promise<AdminOperationResult> {
+  let written = false;
+  const writeOp = op === ADMIN_OP_REMOVE || op === ADMIN_OP_SYNC_FORGET;
+  try {
+    await assertOwnerOnlyDirectories(dataDir);
+    const path = adminSocketPath(dataDir);
+    await privateSocket(path);
+    const socket = createConnection(path);
+    socket.on("error", () => undefined);
+    const response = readCapped(socket, RESPONSE_MAX_BYTES[op], IMPORT_DEADLINE_MS + 5000);
+    socket.once("connect", () => {
+      written = true;
+      socket.end(JSON.stringify({ op, payload }));
+    });
+    try {
+      const raw: unknown = JSON.parse(await response);
+      return parseWireResponse(op, raw);
+    } finally { socket.destroy(); }
+  } catch (error) {
+    if (!written) throw new ImportFailure("ADMIN_UNAVAILABLE");
+    if (error instanceof ImportFailure) {
+      // (c) over-sized reply, (b) lost reply or body that is not parseable.
+      if (error.code === "PAYLOAD_TOO_LARGE") throw new ImportFailure("RESPONSE_TOO_LARGE");
+      if (error.code === "TIMEOUT") throw new ImportFailure("TIMEOUT");
+      throw new ImportFailure(writeOp ? "RESULT_UNKNOWN" : "RESPONSE_INVALID");
+    }
+    throw new ImportFailure(writeOp ? "RESULT_UNKNOWN" : "RESPONSE_INVALID");
+  }
+}
+
+function parseWireResponse(op: AdminOp, raw: unknown): AdminOperationResult {
+  if (!raw || typeof raw !== "object" || Array.isArray(raw) || !("ok" in raw)) throw new ImportFailure("RESPONSE_INVALID");
+  const response = raw as Record<string, unknown>;
+  if (response.ok === false) {
+    if (typeof response.code !== "string" || !FAILURE_CODES.some((code) => code === response.code)) throw new ImportFailure("RESPONSE_INVALID");
+    const allowed = op === ADMIN_OP_REMOVE && response.code === "DEFAULT_TRANSFER_ORDER_UNKNOWN"
+      ? ["ok", "code", "removed", "defaultTransfer"]
+      : ["ok", "code"];
+    if (Object.keys(response).some((key) => !allowed.includes(key))) throw new ImportFailure("RESPONSE_INVALID");
+    if (allowed.length === 4) {
+      const removed = response.removed as Record<string, unknown> | undefined;
+      const transfer = response.defaultTransfer as Record<string, unknown> | undefined;
+      if (!removed || typeof removed.providerId !== "string" || removed.secretCleared !== true) throw new ImportFailure("RESPONSE_INVALID");
+      if (!transfer || transfer.state !== "not_transferred" || transfer.reason !== "order_unknown" || transfer.orderingBasis !== "none") throw new ImportFailure("RESPONSE_INVALID");
+    }
+    return { ok: false, code: response.code as AdminFailureCode };
+  }
+  if (response.ok !== true) throw new ImportFailure("RESPONSE_INVALID");
+  const bodyKey = BODY_KEY[op];
+  if (Object.keys(response).length !== 2 || !(bodyKey in response)) throw new ImportFailure("RESPONSE_INVALID");
+  return { ok: true, value: parseBody(op, response[bodyKey]) };
+}
+
+function parseBody(op: AdminOp, body: unknown): unknown {
+  try {
+    switch (op) {
+      case ADMIN_OP_IMPORT: return parseProviderImportSummary(body);
+      case ADMIN_OP_REMOVE: return parseProviderRemoveSummary(body);
+      case ADMIN_OP_BINDING_STATUS: return parseProviderBindingStatus(body);
+      case ADMIN_OP_REMOVE_STATUS: return parseProviderRemoveStatus(body);
+      case ADMIN_OP_SYNC_FORGET: return parseProviderSyncForgetSummary(body);
+    }
+  } catch {
+    throw new ImportFailure("RESPONSE_INVALID");
+  }
+}
