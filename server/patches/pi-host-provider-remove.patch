+ * (FROZEN 2026-11-03). Every test names the §12 case it covers; cases that need a
+ * real host-core binary, a real server or two architectures are listed in
+ * `server/README.md` instead of being faked here.
+ */
+
+const initialCwd = process.cwd();
+const directories: string[] = [];
+const servers: AdminSocket[] = [];
+beforeAll(() => { process.chdir(process.env.PI_SCRATCH_DIR ?? tmpdir()); });
+afterEach(async () => {
+  for (const server of servers.splice(0)) await server.close();
+  for (const dir of directories.splice(0)) await rm(dir, { recursive: true, force: true });
+});
+afterAll(() => { process.chdir(initialCwd); });
+
+async function directory(): Promise<string> {
+  const dir = await mkdtemp(join(process.cwd(), "provider-remove-"));
+  directories.push(dir);
+  return dir;
+}
+
+type Row = {
+  id: string;
+  name: string;
+  enabled: boolean;
+  models: Array<{ id: string }>;
+  authKind: string;
+  hasSecret: boolean;
+  hasOauth?: boolean;
+  createdAt?: string;
+  defaultModelId?: string;
+  ownerPluginId?: string;
+};
+
+const MINUTE = "2026-01-01T00:00:00.000Z";
+
+function row(overrides: Partial<Row> = {}): Row {
+  return {
+    id: randomUUID(),
+    name: "provider",
+    enabled: true,
+    models: [{ id: "model-a" }],
+    authKind: "api_key",
+    hasSecret: true,
+    createdAt: MINUTE,
+    ...overrides,
+  };
+}
+
+class Host {
+  rows = new Map<string, Row>();
+  secrets = new Map<string, string>();
+  settings: Record<string, unknown> = {};
+  calls: Array<{ method: string; params: Record<string, unknown> }> = [];
+  session: Record<string, unknown> | null = { id: "ses_1", mode: "agent" };
+  sessionSequence: Array<Record<string, unknown> | null> = [];
+  deleteFailure?: unknown;
+  settingsFailure?: unknown;
+  listFailure?: unknown;
+  settingsSetFailure?: unknown;
+  keepSecret = false;
+  count(method: string): number {
+    return this.calls.filter((call) => call.method === method).length;
+  }
+  add(entity: Row, secret: string | null = "sk"): Row {
+    this.rows.set(entity.id, entity);
+    if (secret !== null) this.secrets.set(entity.id, secret);
+    return entity;
+  }
+  async call<T>(method: string, params: Record<string, unknown> = {}): Promise<T> {
+    this.calls.push({ method, params });
+    const id = String(params.id ?? "");
+    switch (method) {
+      case "providers.get": return { provider: structuredClone(this.rows.get(id) ?? null) } as T;
+      case "providers.list": {
+        if (this.listFailure) throw this.listFailure;
+        return { providers: structuredClone([...this.rows.values()]) } as T;
+      }
+      case "providers.create": {
+        const { secretValue, ...input } = params;
+        const created = row({ id: randomUUID(), name: String(input.name ?? "provider") });
+        this.rows.set(created.id, created);
+        if (typeof secretValue === "string") this.secrets.set(created.id, secretValue);
+        return { provider: structuredClone(created) } as T;
+      }
+      case "providers.getSecret": return { value: this.secrets.get(id) ?? null } as T;
+      case "providers.delete": {
+        if (this.deleteFailure) throw this.deleteFailure;
+        this.rows.delete(id);
+        if (!this.keepSecret) this.secrets.delete(id);
+        return { ok: true } as T;
+      }
+      case "settings.get": {
+        if (this.settingsFailure) throw this.settingsFailure;
+        return { ...this.settings } as T;
+      }
+      case "settings.set": {
+        if (this.settingsSetFailure) throw this.settingsSetFailure;
+        Object.assign(this.settings, params);
+        return { ok: true } as T;
+      }
+      case "session.get": {
+        const next = this.sessionSequence.length > 0 ? this.sessionSequence.shift() : this.session;
+        return { session: structuredClone(next ?? null) } as T;
+      }
