+/* -------------------------------------------------------------- dispatch */
+
+async function dispatch(op: AdminOp, payload: unknown, host: HostCaller, dataDir: string, context: { signal: AbortSignal; slotFree: boolean }): Promise<WireResponse> {
+  switch (op) {
+    case ADMIN_OP_IMPORT: {
+      const summary = await importProviders(host, dataDir, payload as ProviderImportPayload, context.signal);
+      return { ok: true, summary };
+    }
+    case ADMIN_OP_REMOVE: {
+      const outcome: RemoveOutcome = await removeProvider(host, payload as ProviderRemovePayload, context.signal);
+      return outcome.ok ? { ok: true, removed: outcome.removed } : { ...outcome };
+    }
+    case ADMIN_OP_BINDING_STATUS: {
+      const outcome: BindingOutcome = await bindingStatusFor(host, dataDir, (payload as { sessionId: string }).sessionId, context.signal);
+      return outcome.ok ? { ok: true, binding: outcome.binding } : { ok: false, code: outcome.code };
+    }
+    case ADMIN_OP_REMOVE_STATUS: {
+      const outcome: RemoveStatusOutcome = await removeStatusFor(host, dataDir, (payload as ProviderRemovePayload).providerId, context);
+      return outcome.ok ? { ok: true, status: outcome.status } : { ok: false, code: outcome.code };
+    }
+    case ADMIN_OP_SYNC_FORGET: {
+      const outcome: ForgetOutcome = await forgetProvider(host, dataDir, payload as ProviderSyncForgetPayload, context.signal);
+      return outcome.ok ? { ok: true, forgotten: outcome.forgotten } : { ok: false, code: outcome.code };
+    }
+  }
+  throw new ImportFailure("INVALID_REQUEST");
