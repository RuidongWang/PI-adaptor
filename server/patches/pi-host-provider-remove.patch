+async function rawRequest(path: string, body: string): Promise<unknown> {
+  const socket = createConnection(path);
+  socket.on("error", () => undefined);
+  const response = readCapped(socket, ADMIN_MAX_BYTES, 5_000);
+  socket.once("connect", () => socket.end(body));
+  try {
+    return JSON.parse(await response);
+  } finally {
+    socket.destroy();
+  }
+}
