+      removed?: { providerId: string; secretCleared: true };
+      defaultTransfer?: { state: "not_transferred"; reason: "order_unknown"; orderingBasis: "none" };
+    };
+export type ForgetOutcome = { ok: true; forgotten: ProviderSyncForgetSummary } | { ok: false; code: AdminFailureCode };
+export type BindingOutcome = { ok: true; binding: ProviderBindingStatus } | { ok: false; code: AdminFailureCode };
+export type RemoveStatusOutcome = { ok: true; status: ProviderRemoveStatus } | { ok: false; code: AdminFailureCode };
+
+/* --------------------------------------------------------------- host reads */
+
+function check(signal: AbortSignal): void {
+  if (signal.aborted) throw new ImportFailure("TIMEOUT");
+}
+
+function isPluginOwned(row: ProviderRow | null): boolean {
+  return Boolean(row && typeof row.ownerPluginId === "string" && row.ownerPluginId.length > 0);
+}
+
+/** `providers.get` returns `{provider:null}` for a missing row; that is not an error (§2.4.1a). */
+async function readRow(host: HostCaller, id: string, signal: AbortSignal): Promise<ProviderRow | null> {
+  const result = await host.call<{ provider?: ProviderRow | null }>("providers.get", { id });
+  check(signal);
+  return result?.provider ?? null;
+}
+
+/**
+ * The only secret operation this increment allows is the emptiness check (§5.7):
+ * the value is reduced to a boolean and dropped on the same statement.
+ */
+async function readSecretPresence(host: HostCaller, id: string, signal: AbortSignal): Promise<boolean> {
+  const result = await host.call<{ value?: string | null }>("providers.getSecret", { id });
+  check(signal);
+  return typeof result?.value === "string" && result.value.length > 0;
+}
+
+type SettingsSnapshot = { defaultProviderId: string | null; defaultModelId: string | null };
+async function readSettings(host: HostCaller, signal: AbortSignal): Promise<SettingsSnapshot> {
+  const settings = await host.call<Record<string, unknown>>("settings.get");
+  check(signal);
+  // A missing key means "not set"; it is never an empty string (§4.3).
+  const providerId = typeof settings?.defaultProviderId === "string" && settings.defaultProviderId.length > 0 ? settings.defaultProviderId : null;
+  const modelId = typeof settings?.defaultModelId === "string" && settings.defaultModelId.length > 0 ? settings.defaultModelId : null;
+  return { defaultProviderId: providerId, defaultModelId: modelId };
+}
+
+async function readRows(host: HostCaller, signal: AbortSignal): Promise<ProviderRow[]> {
+  const result = await host.call<{ providers?: ProviderRow[] }>("providers.list", { includeDisabled: true });
+  check(signal);
+  return Array.isArray(result?.providers) ? result.providers.filter((row) => row && typeof row.id === "string") : [];
+}
+
+/**
+ * §2.4.3 `receiptPresent`: a read of `provider-sync.json` only. `loadJournal`
+ * never writes when the file is absent, so a missing journal cannot create one.
+ */
+async function readReceiptPresence(dataDir: string, providerId: string): Promise<boolean> {
+  const journal = await loadJournal(journalPath(dataDir)).catch(() => {
+    // A corrupt or unreadable journal yields no conclusion, never "absent".
+    throw new ImportFailure("ADMIN_UNAVAILABLE");
+  });
+  return Object.values(journal.receipts).some((receipt) => receipt.providerId === providerId);
+}
+
+/* ------------------------------------------------------- P1 plan (§4.3, §5.7) */
+
+type TransferPlan = {
+  remaining: number;
+  /** §4.3 `eligible`: pre-filter and `pluginAllowed`, before the §5.7 secret review. */
+  eligible: number;
+  ordered: ProviderCandidateRow[];
+  comparable: boolean;
+};
+
+/**
+ * §4.3 for the write path (`includePluginOwned:false`): candidate rows come from
+ * `providers.list`, and the only source of `ownerPluginId` is the single
+ * `providers.get` row — it is not one of the measured list fields. A row whose
+ * record cannot be read is unknown, so no `settings.set` may follow.
+ */
+async function planTransfer(host: HostCaller, rows: readonly ProviderRow[], targetId: string, signal: AbortSignal): Promise<TransferPlan> {
+  const remaining = rows.filter((row) => row.id !== targetId);
+  const allowed: ProviderRow[] = [];
+  for (const row of remaining) {
+    if (!isEligibleCandidate(row)) continue;
+    const record = await readRow(host, row.id, signal);
+    if (!record) throw new ImportFailure("REMOVE_FAILED");
+    if (isPluginOwned(record)) continue;
+    allowed.push(row);
+  }
+  const order = orderEligibleCandidates(allowed);
+  return { remaining: remaining.length, eligible: allowed.length, ordered: order.ordered, comparable: order.comparable };
+}
+
+/** §5.7: walk the full order and take the first candidate whose real secret is present. */
+async function pickTransferTarget(host: HostCaller, plan: TransferPlan, signal: AbortSignal): Promise<{ providerId: string; modelId: string } | null> {
+  for (const row of plan.ordered) {
+    const modelId = candidateModelId(row);
+    if (!modelId) continue;
+    const present = row.authKind === "none" ? true : await readSecretPresence(host, row.id, signal);
+    if (present) return { providerId: row.id, modelId };
+  }
+  return null;
+}
+
+function noCandidateDefaultMoved(plan: TransferPlan): DefaultMoved {
+  return plan.remaining === 0
+    ? { to: null, reason: "no_remaining", orderingBasis: "none" }
+    : { to: null, reason: "no_eligible_candidate", orderingBasis: "none" };
+}
+
+/* --------------------------------------------------------------- the removal */
+
+/**
+ * §4.1 step order — the only order this Host may use. Everything before step 5
+ * can still be reported as "not executed"; everything after it cannot.
+ */
+export async function removeProvider(host: HostCaller, payload: ProviderRemovePayload, signal: AbortSignal): Promise<RemoveOutcome> {
+  let issuedDelete = false;
+  try {
+    check(signal);
+    // 1. existence
+    const row = await readRow(host, payload.providerId, signal);
+    // 2. plugin rows are refused locally, before any delete call (T-45)
+    if (row && isPluginOwned(row)) return { ok: false, code: "PLUGIN_OWNED" };
+    // 3. default bindings
+    const settings = await readSettings(host, signal);
+    const rows = await readRows(host, signal);
+    const wasDefault = settings.defaultProviderId === payload.providerId;
+
+    if (!row) {
+      // §6.2 short circuit: an absent row is a result, not an error, and it still
+      // owes the same self-check evidence as a real delete.
+      const plan = await planTransfer(host, rows, payload.providerId, signal);
+      const secretPresent = await readSecretPresence(host, payload.providerId, signal);
+      return {
+        ok: true,
+        removed: {
+          providerId: payload.providerId,
+          effect: "absent",
+          secretCleared: !secretPresent,
+          remaining: plan.remaining,
+          remainingEligible: plan.eligible,
+        },
+      };
+    }
+
+    // 4. pre-delete decidability, only when the target is the default
+    let plan = await planTransfer(host, rows, payload.providerId, signal);
+    if (wasDefault && plan.eligible > 0 && !plan.comparable) return { ok: false, code: "DEFAULT_ORDER_UNDECIDABLE" };
+
+    // 5. the single delete RPC
+    issuedDelete = true;
+    try {
+      await host.call("providers.delete", { id: payload.providerId });
+    } catch (error) {
+      // No reply says nothing about the write; a peer error replied before writing.
+      return { ok: false, code: isUnknownOutcome(error) ? "RESULT_UNKNOWN" : "REMOVE_FAILED" };
+    }
+    check(signal);
+
+    // 6. self-check: the row and its secret must both be gone
+    if (await readRow(host, payload.providerId, signal)) return { ok: false, code: "RESULT_UNKNOWN" };
+    if (await readSecretPresence(host, payload.providerId, signal)) return { ok: false, code: "SECRET_NOT_CLEARED" };
+
+    // 7/8. default transfer, including a default that started pointing at the
+    // deleted row during the operation (§4.1 step 8).
+    const after = await readSettings(host, signal);
+    plan = await planTransfer(host, await readRows(host, signal), payload.providerId, signal);
+    const counts = { remaining: plan.remaining, remainingEligible: plan.eligible };
+    if (!wasDefault && after.defaultProviderId !== payload.providerId) {
+      return { ok: true, removed: { providerId: payload.providerId, effect: "deleted", secretCleared: true, ...counts } };
+    }
+    if (plan.eligible > 0 && !plan.comparable) {
+      return {
+        ok: false,
+        code: "DEFAULT_TRANSFER_ORDER_UNKNOWN",
+        removed: { providerId: payload.providerId, secretCleared: true },
+        defaultTransfer: { state: "not_transferred", reason: "order_unknown", orderingBasis: "none" },
+      };
+    }
+    const target = plan.eligible === 0 ? null : await pickTransferTarget(host, plan, signal);
+    if (!target) {
+      // §4.3: never clear `settings`, never pretend a transfer happened.
+      return { ok: true, removed: { providerId: payload.providerId, effect: "deleted", secretCleared: true, defaultMoved: noCandidateDefaultMoved(plan), ...counts } };
+    }
+    try {
+      await host.call("settings.set", { defaultProviderId: target.providerId, defaultModelId: target.modelId });
+    } catch (error) {
+      return { ok: false, code: isUnknownOutcome(error) ? "DEFAULT_TRANSFER_UNKNOWN" : "DEFAULT_TRANSFER_FAILED" };
+    }
+    return {
+      ok: true,
+      removed: {
+        providerId: payload.providerId,
+        effect: "deleted",
+        secretCleared: true,
+        defaultMoved: { to: target, orderingBasis: "createdAt" },
+        ...counts,
+      },
+    };
+  } catch (error) {
+    if (error instanceof ImportFailure) throw error;
+    // The delete frame may be out: nothing may be reported as "not executed".
+    throw new ImportFailure(issuedDelete ? "RESULT_UNKNOWN" : "ADMIN_UNAVAILABLE");
+  }
+}
+
+/** §7.2: a transport deadline or a lost host says nothing about the write. */
+function isUnknownOutcome(error: unknown): boolean {
+  return isRpcTimeoutError(error) || (error as { errorCode?: string } | null)?.errorCode === "HOST_UNAVAILABLE";
+}
+
+/* --------------------------------------------------------- receipts (§7.4) */
+
+/** §7.4.2: delete only the receipt entries that point at the target; never touch rows, secrets, settings or the salt. */
+export async function forgetProvider(host: HostCaller, dataDir: string, payload: ProviderSyncForgetPayload, signal: AbortSignal): Promise<ForgetOutcome> {
+  check(signal);
+  const row = await readRow(host, payload.providerId, signal);
+  if (row) return { ok: false, code: "TARGET_STILL_EXISTS" };
+  const journal = await loadJournal(journalPath(dataDir)).catch(() => null);
+  if (!journal) return { ok: false, code: "FORGET_FAILED" };
+  const keys = Object.entries(journal.receipts)
+    .filter(([, receipt]) => receipt.providerId === payload.providerId)
+    .map(([key]) => key);
+  if (keys.length === 0) {
+    // Nothing to remove: the file is not rewritten, so its bytes cannot change (§7.4.2).
+    return { ok: true, forgotten: { providerId: payload.providerId, removedEntries: 0, remainingEntries: Object.keys(journal.receipts).length, receiptState: "absent" } };
+  }
+  for (const key of keys) delete journal.receipts[key];
+  try {
+    await saveJournal(journalPath(dataDir), journal);
+  } catch {
+    // Before `rename` the old file still holds every receipt (§7.4.4).
+    return { ok: false, code: "FORGET_FAILED" };
+  }
+  return { ok: true, forgotten: { providerId: payload.providerId, removedEntries: keys.length, remainingEntries: Object.keys(journal.receipts).length, receiptState: "absent" } };
+}
+
+/* ------------------------------------------------- bindingStatus (§2.4.2) */
+
+type NormalizedRow = {
+  id: string;
+  enabled: boolean;
+  models: string[];
+  authKind: string | null;
+  hasSecret: boolean | null;
+  hasOauth: boolean | null;
+  createdAt: string | null;
+};
+type BindingSnapshot = {
+  session: { providerId: string | null; modelId: string | null; thinkingLevel: string | null; updatedAt: string | null; mode: string | null };
+  rows: NormalizedRow[];
+  settings: SettingsSnapshot;
+  target: { id: string; ownerPluginId: string | null; secretPresent: boolean | null } | null;
+  receiptPresent: boolean;
+  unknownInputs: string[];
+};
+
+function normalizeRows(rows: readonly ProviderRow[]): NormalizedRow[] {
+  return rows
+    .map((row) => ({
+      id: row.id,
+      enabled: row.enabled === true,
+      models: Array.isArray(row.models) ? row.models.map((model) => String(model?.id ?? "")) : [],
+      authKind: typeof row.authKind === "string" ? row.authKind : null,
+      hasSecret: typeof row.hasSecret === "boolean" ? row.hasSecret : null,
+      hasOauth: typeof row.hasOauth === "boolean" ? row.hasOauth : null,
+      createdAt: typeof row.createdAt === "string" ? row.createdAt : null,
+    }))
+    .sort((left, right) => (left.id < right.id ? -1 : left.id > right.id ? 1 : 0));
+}
+
+function textOrNull(value: unknown, max = 512): string | null {
+  return typeof value === "string" && value.length > 0 && value.length <= max ? value : null;
+}
+
+async function readBindingSnapshot(host: HostCaller, dataDir: string, sessionId: string, signal: AbortSignal): Promise<BindingSnapshot> {
+  const unknownInputs: string[] = [];
+  const detail = await host.call<{ session?: Record<string, unknown> | null }>("session.get", { id: sessionId, messageLimit: 1 });
+  check(signal);
+  const session = detail?.session;
+  if (!session) throw new ImportFailure("NOT_FOUND");
+
+  let rows: ProviderRow[] = [];
+  try {
+    rows = await readRows(host, signal);
+  } catch {
+    unknownInputs.push("providers.list");
+  }
+  let settings: SettingsSnapshot = { defaultProviderId: null, defaultModelId: null };
+  let settingsKnown = true;
+  try {
+    settings = await readSettings(host, signal);
+  } catch {
+    settingsKnown = false;
+    unknownInputs.push("settings.get");
+  }
+
+  const pinProviderId = textOrNull(session.providerId);
+  const targetId = pinProviderId ?? fallbackTarget(rows, settings, settingsKnown, unknownInputs);
+  let target: BindingSnapshot["target"] = null;
+  if (targetId) {
+    try {
+      const record = await readRow(host, targetId, signal);
+      if (!record) {
+        // §5.6.1: a successful read with no row means the provider is gone
+        // (`provider_missing`), not that the input is unknown.
+        target = { id: targetId, ownerPluginId: null, secretPresent: null };
+      } else {
+        let secretPresent = record.authKind === "none" ? true : null;
+        if (record.authKind !== "none") {
+          try {
+            secretPresent = await readSecretPresence(host, targetId, signal);
+          } catch {
+            secretPresent = null;
+            unknownInputs.push("providers.getSecret");
+          }
+        }
+        target = { id: targetId, ownerPluginId: textOrNull(record.ownerPluginId), secretPresent };
+      }
+    } catch {
+      unknownInputs.push("providers.get");
+    }
+  }
+  // The journal is only a consistency input here (it is not part of the binding
+  // verdict), so an unreadable journal cannot turn the conclusion into "unknown".
+  const receiptPresent = await readReceiptPresence(dataDir, targetId ?? "").catch(() => false);
+  return {
+    session: {
+      providerId: pinProviderId,
+      modelId: textOrNull(session.modelId),
+      thinkingLevel: textOrNull(session.thinkingLevel, 32),
+      updatedAt: textOrNull(session.updatedAt, 64),
+      mode: textOrNull(session.mode, 32),
+    },
+    rows: normalizeRows(rows),
+    settings,
+    target,
+    receiptPresent,
+    unknownInputs: [...new Set(unknownInputs)],
+  };
+}
+
+/**
+ * §5.6 target for a session without a pin: the default when it is inside the P1
+ * eligible set, otherwise the earliest eligible candidate. The read path uses
+ * `includePluginOwned:true`, so no per-row `providers.get` is needed here.
+ */
+function fallbackTarget(rows: readonly ProviderRow[], settings: SettingsSnapshot, settingsKnown: boolean, unknownInputs: string[]): string | null {
+  if (!settingsKnown) return null;
+  const eligible = rows.filter(isEligibleCandidate);
+  if (settings.defaultProviderId && eligible.some((row) => row.id === settings.defaultProviderId)) return settings.defaultProviderId;
+  const order = orderEligibleCandidates(eligible);
+  if (!order.comparable) {
+    // §4.3: an incomparable batch names no "earliest" candidate.
+    if (eligible.length > 0) unknownInputs.push("providers.list");
+    return null;
+  }
+  return order.ordered[0]?.id ?? null;
+}
+
+function sameSnapshot(left: BindingSnapshot, right: BindingSnapshot): boolean {
+  const strip = (snapshot: BindingSnapshot) => JSON.stringify({ ...snapshot, unknownInputs: [] });
+  return strip(left) === strip(right);
+}
+
+/**
+ * §5.6.1/§5.6.2 evaluation. The short-circuit order is frozen:
+ * provider_missing > provider_disabled > oauth_unsupported > models_empty >
+ * model_removed > secret_missing; `pluginOwned` and `secretMismatch` are pure
+ * information bits — they are read whenever the row exists and never short-circuit.
+ */
+function evaluateBinding(snapshot: BindingSnapshot, sessionId: string, observedAt: string, reads: number, stable: boolean): ProviderBindingStatus {
+  const pinned = { providerId: snapshot.session.providerId, modelId: snapshot.session.modelId, thinkingLevel: snapshot.session.thinkingLevel };
+  const unknownInputs = [...snapshot.unknownInputs];
+  const target = snapshot.target;
+  const row = target ? snapshot.rows.find((candidate) => candidate.id === target.id) : undefined;
+  const checks: ProviderBindingStatus["checks"] = {
+    providerKnown: null,
+    providerEnabled: null,
+    modelsEmpty: null,
+    modelPresent: null,
+    secretPresent: null,
+    oauth: null,
+    pluginOwned: null,
+    secretMismatch: null,
+  };
+  const modelIdOf = (): { modelId: string; modelSource: ProviderBindingEffective["modelSource"] } | null => {
+    if (target && pinned.providerId === target.id && pinned.modelId) return { modelId: pinned.modelId, modelSource: "session" };
+    if (target && snapshot.settings.defaultProviderId === target.id && snapshot.settings.defaultModelId) return { modelId: snapshot.settings.defaultModelId, modelSource: "default" };
+    const first = row?.models[0] ?? (target ? snapshot.rows.find((candidate) => candidate.id === target.id)?.models[0] : undefined);
+    return first ? { modelId: first, modelSource: "provider_first" } : null;
+  };
+  const effectiveOf = (): ProviderBindingEffective | null => {
+    if (!target) return null;
+    const resolved = modelIdOf();
+    if (!resolved) return null;
+    const providerSource: ProviderBindingEffective["providerSource"] = pinned.providerId
+      ? "pin"
+      : snapshot.settings.defaultProviderId === target.id
+        ? "default"
+        : "fallback";
+    return { providerId: target.id, modelId: resolved.modelId, providerSource, modelSource: resolved.modelSource };
+  };
+  const result = (available: boolean | null, unavailableReason: ProviderBindingStatus["unavailableReason"], effective: ProviderBindingEffective | null): ProviderBindingStatus => ({
+    sessionId,
+    pinned,
+    effective,
+    available,
+    unavailableReason,
+    checks,
+    unknownInputs,
+    consistency: { reads, snapshotStable: stable },
+    isDefault: Boolean(effective && snapshot.settings.defaultProviderId === effective.providerId),
+    revision: null,
+    sessionUpdatedAt: snapshot.session.updatedAt,
+    maxAgeMs: STATUS_MAX_AGE_MS,
+    observedAt,
+  });
+
+  // §5.6.2: no pin and no candidate — "which provider" itself is undetermined,
+  // so the reason is `no_candidate`, never `provider_missing`.
+  if (!pinned.providerId && !target) return result(false, "no_candidate", null);
+  if (unknownInputs.length > 0) return result(null, "unknown", effectiveOf());
+  if (!target) return result(null, "unknown", null);
+
+  checks.providerKnown = Boolean(row);
+  // §5.6.1: only a row that was actually read can settle `pluginOwned`.
+  checks.pluginOwned = row ? Boolean(target.ownerPluginId) : null;
+  if (!row) return result(false, "provider_missing", null);
+  // Pure information bit: evaluated whenever the row exists, never short-circuits.
+  checks.secretMismatch = row.authKind === "none" || row.hasSecret === null || target.secretPresent === null
+    ? false
+    : row.hasSecret !== target.secretPresent;
+  checks.providerEnabled = row.enabled;
+  if (!checks.providerEnabled) return result(false, "provider_disabled", effectiveOf());
+  checks.oauth = row.authKind === null ? null : row.authKind === "oauth" || row.hasOauth === true;
+  checks.modelsEmpty = row.models.length === 0;
+  if (checks.oauth === null) return result(null, "unknown", effectiveOf());
+  if (checks.oauth) return result(false, "oauth_unsupported", effectiveOf());
+  if (checks.modelsEmpty) return result(false, "models_empty", effectiveOf());
+  const resolved = modelIdOf();
+  checks.modelPresent = resolved ? row.models.includes(resolved.modelId) : null;
+  if (checks.modelPresent === null) return result(null, "unknown", effectiveOf());
+  if (!checks.modelPresent) return result(false, "model_removed", effectiveOf());
+  checks.secretPresent = target.secretPresent;
+  if (checks.secretPresent === null) return result(null, "unknown", effectiveOf());
+  if (!checks.secretPresent) return result(false, "secret_missing", effectiveOf());
+  return result(true, null, effectiveOf());
+}
+
+/** §2.4.2 + §7.5.2: two equivalent reads at least 50 ms apart, one extra read when they differ. */
+export async function bindingStatusFor(host: HostCaller, dataDir: string, sessionId: string, signal: AbortSignal): Promise<BindingOutcome> {
+  const first = await readBindingSnapshot(host, dataDir, sessionId, signal);
+  if (first.unknownInputs.length > 0) return { ok: true, binding: evaluateBinding(first, sessionId, new Date().toISOString(), 1, false) };
+  await new Promise((settle) => setTimeout(settle, 50));
+  check(signal);
+  const second = await readBindingSnapshot(host, dataDir, sessionId, signal);
+  if (second.unknownInputs.length === 0 && sameSnapshot(first, second)) {
+    return { ok: true, binding: evaluateBinding(second, sessionId, new Date().toISOString(), 2, true) };
+  }
+  await new Promise((settle) => setTimeout(settle, 50));
+  check(signal);
+  const third = await readBindingSnapshot(host, dataDir, sessionId, signal);
+  if (third.unknownInputs.length === 0 && sameSnapshot(second, third)) {
+    return { ok: true, binding: evaluateBinding(third, sessionId, new Date().toISOString(), 3, true) };
+  }
+  return { ok: false, code: "SNAPSHOT_UNSTABLE" };
+}
+
+/* ------------------------------------------------ removeStatus (§2.4.3) */
+
+type StatusSnapshot = {
+  recordPresent: boolean;
+  secretPresent: boolean | null;
+  enabled: boolean | null;
+  modelCount: number | null;
+  settings: SettingsSnapshot;
+  receiptPresent: boolean;
+};
+
+async function readStatusSnapshot(host: HostCaller, dataDir: string, providerId: string, signal: AbortSignal): Promise<StatusSnapshot> {
+  const record = await readRow(host, providerId, signal);
+  const settings = await readSettings(host, signal);
+  let secretPresent: boolean | null = null;
+  try {
+    // A deleted row still owes the "is the secret gone" observation (§7.3).
+    secretPresent = record && record.authKind === "none" ? true : await readSecretPresence(host, providerId, signal);
+  } catch {
+    secretPresent = null;
+  }
+  return {
+    recordPresent: Boolean(record),
+    secretPresent,
+    enabled: record ? record.enabled === true : null,
+    modelCount: record && Array.isArray(record.models) ? record.models.length : null,
+    settings,
+    receiptPresent: await readReceiptPresence(dataDir, providerId),
+  };
+}
+
+/** §2.4.3 + §7.5.2; `writeOrderingProof` stays `"unproven"` (§7.5.3, §11A.7). */
+export async function removeStatusFor(host: HostCaller, dataDir: string, providerId: string, context: AdminOperationContext): Promise<RemoveStatusOutcome> {
+  const first = await readStatusSnapshot(host, dataDir, providerId, context.signal);
+  await new Promise((settle) => setTimeout(settle, 50));
+  check(context.signal);
+  const second = await readStatusSnapshot(host, dataDir, providerId, context.signal);
+  if (JSON.stringify(first) !== JSON.stringify(second)) {
+    await new Promise((settle) => setTimeout(settle, 50));
+    check(context.signal);
+    const third = await readStatusSnapshot(host, dataDir, providerId, context.signal);
+    if (JSON.stringify(second) !== JSON.stringify(third)) return { ok: false, code: "SNAPSHOT_UNSTABLE" };
+  }
+  return {
+    ok: true,
+    status: {
+      providerId,
+      recordPresent: second.recordPresent,
+      secretPresent: second.secretPresent,
+      defaultBinding: {
+        isDefault: second.settings.defaultProviderId === providerId,
+        defaultProviderId: second.settings.defaultProviderId,
+      },
+      enabled: second.enabled,
+      modelCount: second.modelCount,
+      receiptPresent: second.receiptPresent,
+      // E1 only: no other admin operation can run while this read holds the slot.
+      slotFree: context.slotFree,
+      writeOrderingProof: "unproven",
+      boundSessionCount: null,
+      maxAgeMs: STATUS_MAX_AGE_MS,
+      observedAt: new Date().toISOString(),
+    },
+  };
+}
+
+/* ------------------------------------------------------------- CLI runners */
+
+type CliOutcome = { ok: true; value: unknown } | { ok: false; code: AdminFailureCode };
+
+/**
+ * Shared CLI discipline (§2.1): one optional `--data-dir`, one bounded stdin
+ * line, one single-line stdout record, exit code 0 or 1.
+ */
+async function runAdminCli(options: {
+  argv: string[];
+  io: { stdin: NodeJS.ReadableStream; stdout: NodeJS.WritableStream };
+  stdinMaxBytes: number;
+  prefix: string;
+  parsePayload: (value: unknown) => unknown;
+  send: (dataDir: string, payload: unknown) => Promise<CliOutcome>;
+}): Promise<number> {
+  const { argv, io } = options;
+  try {
+    if (argv.length !== 0 && !(argv.length === 2 && argv[0] === "--data-dir" && argv[1])) throw new ImportFailure("INVALID_REQUEST");
+    const dataDir = resolve(argv[1] ?? process.env.PI_DESKTOP_DATA_DIR ?? join(homedir(), ".pi-desktop"));
+    const raw = await readCapped(io.stdin, options.stdinMaxBytes);
+    let payload: unknown;
+    try {
+      payload = options.parsePayload(JSON.parse(raw));
+    } catch {
+      throw new ImportFailure("INVALID_REQUEST");
+    }
+    const response = await options.send(dataDir, payload);
+    if (!response.ok) throw new ImportFailure(response.code);
+    io.stdout.write(`${options.prefix} ${JSON.stringify(response.value)}\n`);
+    return 0;
+  } catch (error) {
+    io.stdout.write(`${FAILED_PREFIX} ${JSON.stringify({ code: importFailureCode(error) })}\n`);
+    return 1;
+  }
+}
+
+async function sendOperation(dataDir: string, op: AdminOp, payload: unknown): Promise<CliOutcome> {
+  const { sendAdminOperation } = await import("./admin-socket.js");
+  return sendAdminOperation(dataDir, op, payload);
+}
+
+export async function runProviderRemove(argv: string[], io: { stdin: NodeJS.ReadableStream; stdout: NodeJS.WritableStream } = process): Promise<number> {
+  return runAdminCli({
+    argv,
+    io,
+    stdinMaxBytes: REMOVE_STDIN_MAX_BYTES,
+    prefix: REMOVED_PREFIX,
+    parsePayload: parseProviderRemovePayload,
+    send: (dataDir, payload) => sendOperation(dataDir, ADMIN_OP_REMOVE, payload),
+  });
+}
+
+export async function runProviderBindingStatus(argv: string[], io: { stdin: NodeJS.ReadableStream; stdout: NodeJS.WritableStream } = process): Promise<number> {
+  return runAdminCli({
+    argv,
+    io,
+    stdinMaxBytes: BINDING_STATUS_STDIN_MAX_BYTES,
+    prefix: BINDING_PREFIX,
+    parsePayload: parseProviderBindingStatusPayload,
+    send: (dataDir, payload) => sendOperation(dataDir, ADMIN_OP_BINDING_STATUS, payload),
+  });
+}
+
+export async function runProviderRemoveStatus(argv: string[], io: { stdin: NodeJS.ReadableStream; stdout: NodeJS.WritableStream } = process): Promise<number> {
+  return runAdminCli({
+    argv,
+    io,
+    stdinMaxBytes: REMOVE_STDIN_MAX_BYTES,
+    prefix: REMOVE_STATUS_PREFIX,
+    parsePayload: parseProviderRemovePayload,
+    send: (dataDir, payload) => sendOperation(dataDir, ADMIN_OP_REMOVE_STATUS, payload),
+  });
+}
+
+export async function runProviderSyncForget(argv: string[], io: { stdin: NodeJS.ReadableStream; stdout: NodeJS.WritableStream } = process): Promise<number> {
+  return runAdminCli({
+    argv,
+    io,
+    stdinMaxBytes: FORGET_STDIN_MAX_BYTES,
+    prefix: FORGOTTEN_PREFIX,
+    parsePayload: parseProviderSyncForgetPayload,
+    send: (dataDir, payload) => sendOperation(dataDir, ADMIN_OP_SYNC_FORGET, payload),
+  });
+}
