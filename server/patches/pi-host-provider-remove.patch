new file mode 100644
index 0000000..9246b09
--- /dev/null
+++ b/packages/shared/src/provider-remove.ts
@@ -0,0 +1,443 @@
+import { OAUTH_AUTH_KIND } from "./types/providers.js";
+import type { ModelBinding } from "./types/models.js";
+
+/**
+ * Model-service removal increment, `docs/api/ios-client-provider-remove-draft.md`
+ * (FROZEN 2026-11-03). This module is the single source of truth for the frozen
+ * literals (§2.0), the three byte caps per request (§2.1.1), the stdin payloads
+ * (§2.2, §2.4.2, §2.4.3, §7.4.1), the response schemas (§2.3, §2.4.5, §7.4.1)
+ * and the P1 candidate algorithm (§4.3) shared by the query path, the write path
+ * and the headless launch resolver.
+ */
+
+/** §2.0 — the only allowed spellings. Never normalized. */
+export const ADMIN_OP_IMPORT = "providers.import";
+export const ADMIN_OP_REMOVE = "providers.remove";
+export const ADMIN_OP_BINDING_STATUS = "providers.bindingStatus";
+export const ADMIN_OP_REMOVE_STATUS = "providers.removeStatus";
+export const ADMIN_OP_SYNC_FORGET = "providers.sync.forget";
+
+export const CLI_PROVIDER_IMPORT = "provider-import";
+export const CLI_PROVIDER_REMOVE = "provider-remove";
+export const CLI_PROVIDER_BINDING_STATUS = "provider-binding-status";
+export const CLI_PROVIDER_REMOVE_STATUS = "provider-remove-status";
+export const CLI_PROVIDER_SYNC_FORGET = "provider-sync-forget";
+
+export const PROVIDERS_PREFIX = "PI_HOST_PROVIDERS";
+export const REMOVED_PREFIX = "PI_HOST_REMOVED";
+export const FORGOTTEN_PREFIX = "PI_HOST_FORGOTTEN";
+export const BINDING_PREFIX = "PI_HOST_BINDING";
+export const REMOVE_STATUS_PREFIX = "PI_HOST_REMOVE_STATUS";
+export const FAILED_PREFIX = "PI_HOST_FAILED";
+
+/**
+ * §2.1.1 — (a) stdin payload ceiling, (b) whole admin envelope ceiling and
+ * (c) response ceiling, all counted on raw bytes including line endings.
+ * (a) never truncates the envelope: the socket always reads with the unified
+ * `ADMIN_MAX_BYTES` cap first and validates per op after parsing `op`.
+ */
+export const REMOVE_STDIN_MAX_BYTES = 73;
+export const BINDING_STATUS_STDIN_MAX_BYTES = 164;
+export const REMOVE_STATUS_STDIN_MAX_BYTES = 73;
+export const FORGET_STDIN_MAX_BYTES = 122;
+export const ADMIN_REMOVE_MAX_BYTES = 111;
+export const ADMIN_BINDING_STATUS_MAX_BYTES = 209;
+export const ADMIN_REMOVE_STATUS_MAX_BYTES = 117;
+export const ADMIN_FORGET_MAX_BYTES = 165;
+export const REMOVE_RESPONSE_MAX_BYTES = 1024;
+export const BINDING_STATUS_RESPONSE_MAX_BYTES = 4096;
+export const REMOVE_STATUS_RESPONSE_MAX_BYTES = 1024;
+export const FORGET_RESPONSE_MAX_BYTES = 512;
+
+/** §7.5.2 rule 5 — freshness window, always measured from `observedAt`. */
+export const STATUS_MAX_AGE_MS = 10_000;
+/** §2.1.1 — `sessionId` is variable length, 128 characters is only the upper bound. */
+export const MAX_SESSION_ID_LENGTH = 128;
+
+const PROVIDER_ID_ALLOWED = /^[a-f0-9-]{36}$/i;
+const SESSION_ID_ALLOWED = /^[A-Za-z0-9._:-]{1,128}$/;
+
+function invalid(): never {
+  // Never echo an input value, an unknown field name or a parser diagnostic.
+  throw Object.assign(new Error("Invalid provider removal payload"), { errorCode: "INVALID_ARGUMENT" });
+}
+function record(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+function exact(value: unknown, allowed: readonly string[]): asserts value is Record<string, unknown> {
+  if (!record(value) || Object.keys(value).some((key) => !allowed.includes(key))) invalid();
+}
+function providerId(value: unknown): string {
+  if (typeof value !== "string" || !PROVIDER_ID_ALLOWED.test(value)) invalid();
+  return value;
+}
+function index(value: unknown): number {
+  if (typeof value !== "number" || !Number.isSafeInteger(value) || value < 0) invalid();
+  return value;
+}
+function flag(value: unknown): boolean {
+  if (typeof value !== "boolean") invalid();
+  return value;
+}
+function nullableFlag(value: unknown): boolean | null {
+  if (value !== null && typeof value !== "boolean") invalid();
+  return value as boolean | null;
+}
+
+/* ------------------------------------------------------------------ payloads */
+
+/** §2.2 — `{ "version": 1, "providerId": "<36>" }`, nothing else. */
+export type ProviderRemovePayload = { version: 1; providerId: string };
+export function parseProviderRemovePayload(value: unknown): ProviderRemovePayload {
+  exact(value, ["version", "providerId"]);
+  if (value.version !== 1) invalid();
+  return { version: 1, providerId: providerId(value.providerId) };
+}
+
+/** §2.4.2 — `{ "version": 1, "sessionId": "…" }`, nothing else. */
+export type ProviderBindingStatusPayload = { version: 1; sessionId: string };
+export function parseProviderBindingStatusPayload(value: unknown): ProviderBindingStatusPayload {
+  exact(value, ["version", "sessionId"]);
+  if (value.version !== 1) invalid();
+  if (typeof value.sessionId !== "string" || !SESSION_ID_ALLOWED.test(value.sessionId)) invalid();
+  return { version: 1, sessionId: value.sessionId };
+}
+
+/**
+ * §7.4.1 — exactly three keys in a fixed order; `confirm` must equal `providerId`
+ * byte for byte. `force` and every other fourth key are rejected, never echoed.
+ */
+export type ProviderSyncForgetPayload = { version: 1; providerId: string; confirm: string };
+export function parseProviderSyncForgetPayload(value: unknown): ProviderSyncForgetPayload {
+  exact(value, ["version", "providerId", "confirm"]);
+  if (value.version !== 1) invalid();
+  const target = providerId(value.providerId);
+  if (value.confirm !== target) invalid();
+  return { version: 1, providerId: target, confirm: target };
+}
+
+/* ------------------------------------------------------- remove (§2.3, §2.6) */
+
+export type DefaultMoved =
+  | { to: { providerId: string; modelId: string }; orderingBasis: "createdAt" }
+  | { to: null; reason: "no_remaining" | "no_eligible_candidate"; orderingBasis: "none" };
+
+/** §2.3 / §6.2 — `ok` alone never proves that this call deleted anything. */
+export type ProviderRemoveEffect = "deleted" | "absent";
+
+/**
+ * §2.6 — independent schema for `PI_HOST_REMOVED`; no field is inherited from
+ * `ProviderImportSummary`. `defaultMoved` is absent when the target was not the
+ * default, and never present together with `effect:"absent"`.
+ */
+export type ProviderRemoveSummary = {
+  providerId: string;
+  effect: ProviderRemoveEffect;
+  secretCleared: boolean;
+  defaultMoved?: DefaultMoved;
+  remaining: number;
+  remainingEligible: number;
+};
+
+export function parseProviderRemoveSummary(value: unknown): ProviderRemoveSummary {
+  exact(value, ["providerId", "effect", "secretCleared", "defaultMoved", "remaining", "remainingEligible"]);
+  const effect = value.effect;
+  if (effect !== "deleted" && effect !== "absent") invalid();
+  // §7.2: `ok:true` with `secretCleared !== true` is a protocol error, not a result.
+  if (value.secretCleared !== true) invalid();
+  const summary: ProviderRemoveSummary = {
+    providerId: providerId(value.providerId),
+    effect,
+    secretCleared: true,
+    remaining: index(value.remaining),
+    remainingEligible: index(value.remainingEligible),
+  };
+  if (value.defaultMoved !== undefined) {
+    if (effect === "absent") invalid();
+    summary.defaultMoved = parseDefaultMoved(value.defaultMoved);
+  }
+  return structuredClone(summary);
+}
+
+function parseDefaultMoved(value: unknown): DefaultMoved {
+  exact(value, ["to", "reason", "orderingBasis"]);
+  if (value.orderingBasis !== "createdAt" && value.orderingBasis !== "none") invalid();
+  if (value.to === null) {
+    if (value.orderingBasis !== "none") invalid();
+    if (value.reason !== "no_remaining" && value.reason !== "no_eligible_candidate") invalid();
+    return { to: null, reason: value.reason, orderingBasis: "none" };
+  }
+  if (value.orderingBasis !== "createdAt" || value.reason !== undefined) invalid();
+  exact(value.to, ["providerId", "modelId"]);
+  if (typeof value.to.modelId !== "string" || value.to.modelId.length === 0) invalid();
+  return { to: { providerId: providerId(value.to.providerId), modelId: value.to.modelId }, orderingBasis: "createdAt" };
+}
+
+/* ------------------------------------------------ binding status (§2.4.2/§2.4.5) */
+
+export type ProviderUnavailableReason =
+  | "provider_missing"
+  | "provider_disabled"
+  | "models_empty"
+  | "model_removed"
+  | "secret_missing"
+  | "oauth_unsupported"
+  | "no_candidate"
+  | "unknown";
+
+export const PROVIDER_UNAVAILABLE_REASONS: readonly ProviderUnavailableReason[] = [
+  "provider_missing",
+  "provider_disabled",
+  "models_empty",
+  "model_removed",
+  "secret_missing",
+  "oauth_unsupported",
+  "no_candidate",
+  "unknown",
+];
+export const PROVIDER_SOURCES = ["pin", "default", "fallback"] as const;
+export const PROVIDER_MODEL_SOURCES = ["session", "default", "provider_first"] as const;
+export const UNKNOWN_INPUTS = [
+  "providers.list",
+  "providers.get",
+  "settings.get",
+  "session.get",
+  "providers.getSecret",
+] as const;
+
+/** §5.6.1 — necessary checks, negative bits and pure information bits. */
+export type ProviderBindingChecks = {
+  providerKnown: boolean | null;
+  providerEnabled: boolean | null;
+  modelsEmpty: boolean | null;
+  modelPresent: boolean | null;
+  secretPresent: boolean | null;
+  oauth: boolean | null;
+  pluginOwned: boolean | null;
+  secretMismatch: boolean | null;
+};
+export type ProviderBindingPinned = {
+  providerId: string | null;
+  modelId: string | null;
+  thinkingLevel: string | null;
+};
+export type ProviderBindingEffective = {
+  providerId: string;
+  modelId: string;
+  providerSource: (typeof PROVIDER_SOURCES)[number];
+  modelSource: (typeof PROVIDER_MODEL_SOURCES)[number];
+};
+export type ProviderBindingStatus = {
+  sessionId: string;
+  pinned: ProviderBindingPinned;
+  effective: ProviderBindingEffective | null;
+  available: boolean | null;
+  unavailableReason: ProviderUnavailableReason | null;
+  checks: ProviderBindingChecks;
+  unknownInputs: string[];
+  consistency: { reads: number; snapshotStable: boolean };
+  isDefault: boolean;
+  revision: number | null;
+  sessionUpdatedAt: string | null;
+  maxAgeMs: number;
+  observedAt: string;
+};
+
+function enumValue<T extends string>(value: unknown, allowed: readonly T[]): T {
+  if (typeof value !== "string" || !(allowed as readonly string[]).includes(value)) invalid();
+  return value as T;
+}
+function nullableEnum<T extends string>(value: unknown, allowed: readonly T[]): T | null {
+  if (value === null) return null;
+  return enumValue(value, allowed);
+}
+function stringOrNull(value: unknown): string | null {
+  if (value === null) return null;
+  if (typeof value !== "string" || value.length === 0) invalid();
+  return value;
+}
+
+/** §2.4.5 — strict: required keys always present, nullable keys present as `null`, no unknown key. */
+export function parseProviderBindingStatus(value: unknown): ProviderBindingStatus {
+  exact(value, [
+    "sessionId", "pinned", "effective", "available", "unavailableReason", "checks", "unknownInputs",
+    "consistency", "isDefault", "revision", "sessionUpdatedAt", "maxAgeMs", "observedAt",
+  ]);
+  if (typeof value.sessionId !== "string" || value.sessionId.length === 0) invalid();
+  exact(value.pinned, ["providerId", "modelId", "thinkingLevel"]);
+  exact(value.checks, [
+    "providerKnown", "providerEnabled", "modelsEmpty", "modelPresent", "secretPresent", "oauth", "pluginOwned", "secretMismatch",
+  ]);
+  if (!Array.isArray(value.unknownInputs)) invalid();
+  const unknownInputs = value.unknownInputs.map((input) => enumValue(input, UNKNOWN_INPUTS));
+  exact(value.consistency, ["reads", "snapshotStable"]);
+  const reads = index(value.consistency.reads);
+  if (reads > 3) invalid();
+  return {
+    sessionId: value.sessionId,
+    pinned: {
+      providerId: stringOrNull(value.pinned.providerId),
+      modelId: stringOrNull(value.pinned.modelId),
+      thinkingLevel: stringOrNull(value.pinned.thinkingLevel),
+    },
+    effective: value.effective === null ? null : parseEffective(value.effective),
+    available: nullableFlag(value.available),
+    unavailableReason: nullableEnum(value.unavailableReason, PROVIDER_UNAVAILABLE_REASONS),
+    checks: {
+      providerKnown: nullableFlag(value.checks.providerKnown),
+      providerEnabled: nullableFlag(value.checks.providerEnabled),
+      modelsEmpty: nullableFlag(value.checks.modelsEmpty),
+      modelPresent: nullableFlag(value.checks.modelPresent),
+      secretPresent: nullableFlag(value.checks.secretPresent),
+      oauth: nullableFlag(value.checks.oauth),
+      pluginOwned: nullableFlag(value.checks.pluginOwned),
+      secretMismatch: nullableFlag(value.checks.secretMismatch),
+    },
+    unknownInputs,
+    consistency: { reads, snapshotStable: flag(value.consistency.snapshotStable) },
+    isDefault: flag(value.isDefault),
+    revision: value.revision === null ? null : index(value.revision),
+    sessionUpdatedAt: stringOrNull(value.sessionUpdatedAt),
+    maxAgeMs: index(value.maxAgeMs),
+    observedAt: typeof value.observedAt === "string" && value.observedAt.length > 0 ? value.observedAt : invalid(),
+  };
+}
+
+function parseEffective(value: unknown): ProviderBindingEffective {
+  exact(value, ["providerId", "modelId", "providerSource", "modelSource"]);
+  if (typeof value.providerId !== "string" || value.providerId.length === 0) invalid();
+  if (typeof value.modelId !== "string" || value.modelId.length === 0) invalid();
+  return {
+    providerId: value.providerId,
+    modelId: value.modelId,
+    providerSource: enumValue(value.providerSource, PROVIDER_SOURCES),
+    modelSource: enumValue(value.modelSource, PROVIDER_MODEL_SOURCES),
+  };
+}
+
+/* --------------------------------------------- remove status (§2.4.3/§2.4.5) */
+
+export const WRITE_ORDERING_PROOFS = ["unproven", "proven"] as const;
+
+/** §2.4.3 — observation only: it never answers "did the removal succeed". */
+export type ProviderRemoveStatus = {
+  providerId: string;
+  recordPresent: boolean;
+  secretPresent: boolean | null;
+  defaultBinding: { isDefault: boolean; defaultProviderId: string | null };
+  enabled: boolean | null;
+  modelCount: number | null;
+  receiptPresent: boolean;
+  slotFree: boolean;
+  writeOrderingProof: (typeof WRITE_ORDERING_PROOFS)[number];
+  boundSessionCount: number | null;
+  maxAgeMs: number;
+  observedAt: string;
+};
+
+export function parseProviderRemoveStatus(value: unknown): ProviderRemoveStatus {
+  exact(value, [
+    "providerId", "recordPresent", "secretPresent", "defaultBinding", "enabled", "modelCount",
+    "receiptPresent", "slotFree", "writeOrderingProof", "boundSessionCount", "maxAgeMs", "observedAt",
+  ]);
+  exact(value.defaultBinding, ["isDefault", "defaultProviderId"]);
+  return {
+    providerId: providerId(value.providerId),
+    recordPresent: flag(value.recordPresent),
+    secretPresent: nullableFlag(value.secretPresent),
+    defaultBinding: { isDefault: flag(value.defaultBinding.isDefault), defaultProviderId: stringOrNull(value.defaultBinding.defaultProviderId) },
+    enabled: nullableFlag(value.enabled),
+    modelCount: value.modelCount === null ? null : index(value.modelCount),
+    receiptPresent: flag(value.receiptPresent),
+    slotFree: flag(value.slotFree),
+    writeOrderingProof: enumValue(value.writeOrderingProof, WRITE_ORDERING_PROOFS),
+    boundSessionCount: value.boundSessionCount === null ? null : index(value.boundSessionCount),
+    maxAgeMs: index(value.maxAgeMs),
+    observedAt: typeof value.observedAt === "string" && value.observedAt.length > 0 ? value.observedAt : invalid(),
+  };
+}
+
+/* ------------------------------------------- forget summary (§7.4.1, §7.4.2) */
+
+/** Exactly four keys; `receiptState` has one value in this release. */
+export type ProviderSyncForgetSummary = {
+  providerId: string;
+  removedEntries: number;
+  remainingEntries: number;
+  receiptState: "absent";
+};
+export function parseProviderSyncForgetSummary(value: unknown): ProviderSyncForgetSummary {
+  exact(value, ["providerId", "removedEntries", "remainingEntries", "receiptState"]);
+  if (value.receiptState !== "absent") invalid();
+  return {
+    providerId: providerId(value.providerId),
+    removedEntries: index(value.removedEntries),
+    remainingEntries: index(value.remainingEntries),
+    receiptState: "absent",
+  };
+}
+
+/* ------------------------------------------------- P1 candidates (§4.3, §5.6) */
+
+/** Only the fields §4.3/§5.6 may read; `providers.list` really returns these. */
+export type ProviderCandidateRow = {
+  id: string;
+  enabled?: boolean;
+  models?: Array<{ id: string }>;
+  authKind?: string;
+  hasSecret?: boolean;
+  hasOauth?: boolean;
+  createdAt?: string;
+  defaultModelId?: string;
+};
+
+/** §4.3 — `models[0].id` is the model a candidate would run; `defaultModelId` never overrides it. */
+export function candidateModelId(row: ProviderCandidateRow): string | null {
+  const first = row.models?.[0];
+  return first && typeof first.id === "string" && first.id.length > 0 ? first.id : null;
+}
+
+/**
+ * §4.3 qualification, minus `pluginAllowed` (that needs one `providers.get` per
+ * row and lives where the row records are available). `enabled` is compared
+ * strictly: a missing field is not "enabled".
+ */
+export function isEligibleCandidate(row: ProviderCandidateRow): boolean {
+  if (row.enabled !== true) return false;
+  if (!Array.isArray(row.models) || row.models.length < 1) return false;
+  if (row.authKind === OAUTH_AUTH_KIND || row.hasOauth === true) return false;
+  // `hasSecret` is only the pre-filter; §5.7 re-checks the real secret on candidates.
+  return row.authKind === "none" ? true : row.hasSecret === true;
+}
+
+const RFC3339 = /^\d{4}-\d{2}-\d{2}[Tt]\d{2}:\d{2}:\d{2}(\.\d+)?([Zz]|[+-]\d{2}:\d{2})$/;
+
+/** §4.3 — `createdAt` is comparable only when it parses as RFC3339/ISO8601 with a zone. */
+export function parseCreatedAtInstant(value: unknown): number | null {
+  if (typeof value !== "string" || !RFC3339.test(value)) return null;
+  const instant = Date.parse(value);
+  return Number.isFinite(instant) ? instant : null;
+}
+
+export type CandidateOrdering = {
+  ordered: ProviderCandidateRow[];
+  orderingBasis: "createdAt" | "none";
+  /** True only when every candidate's `createdAt` is comparable. */
+  comparable: boolean;
+};
+
+/**
+ * §4.3 full order: `(createdAt asc, id bytes asc)`. One incomparable candidate
+ * makes the whole batch incomparable and the ordered list empty — there is no
+ * "fall back to id order" and no reliance on the `providers.list` order.
+ */
+export function orderEligibleCandidates(rows: readonly ProviderCandidateRow[]): CandidateOrdering {
+  if (rows.length === 0) return { ordered: [], orderingBasis: "none", comparable: false };
+  const instants = rows.map((row) => parseCreatedAtInstant(row.createdAt));
+  if (instants.some((instant) => instant === null)) return { ordered: [], orderingBasis: "none", comparable: false };
+  const ordered = rows
+    .map((row, position) => ({ row, instant: instants[position] as number }))
+    .sort((left, right) => left.instant - right.instant || (left.row.id < right.row.id ? -1 : left.row.id > right.row.id ? 1 : 0))
+    .map(({ row }) => row);
+  return { ordered, orderingBasis: "createdAt", comparable: true };
+}
