# systemd USER unit for the isolated PI-adaptor host.
#
# Install (do NOT replace any unit that starts the legacy PI-Desktop pi-host):
#   mkdir -p ~/.config/systemd/user
#   cp pi-adaptor.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now pi-adaptor.service
#
# The unit name, env namespace, home, and port are all distinct from the legacy
# host so the two can run side by side with zero shared state.

[Unit]
Description=PI-adaptor (isolated, independent of PI-Desktop pi-host)
After=network.target

[Service]
Type=simple

# Fully isolated root: data/, agent/, logs/, run/ all live below it.
Environment=PI_ADAPTOR_HOME=%h/.pi-adaptor
Environment=PI_ADAPTOR_PORT=19445

# Direct is opt-in. After installing a validated single-leaf certificate and a
# service-owned 0600 key, set PI_ADAPTOR_DIRECT_ENABLED=1 and restart the unit.
Environment=PI_ADAPTOR_DIRECT_ENABLED=0
Environment=PI_ADAPTOR_DIRECT_HOST=0.0.0.0
Environment=PI_ADAPTOR_DIRECT_PORT=9443
Environment=PI_ADAPTOR_DIRECT_CERTIFICATE_FILE=%h/.pi-adaptor/tls/direct-cert.pem
Environment=PI_ADAPTOR_DIRECT_PRIVATE_KEY_FILE=%h/.pi-adaptor/tls/direct-key.pem
Environment=PI_ADAPTOR_DIRECT_MAX_CONNECTIONS=64
Environment=PI_ADAPTOR_DIRECT_MESSAGE_RATE_COUNT=60
Environment=PI_ADAPTOR_DIRECT_MESSAGE_RATE_WINDOW_MS=10000
Environment=PI_ADAPTOR_DIRECT_UNAUTHENTICATED_TIMEOUT_MS=10000

# Absolute path to the built entrypoint for the deployed version.
# NOTE: this template assumes Node is installed at /usr/bin/node. If Node is
# managed by nvm/asdf, create a systemd drop-in overriding ExecStart with the
# absolute interpreter path (systemd does not expand shell PATH lookups), and
# make sure the service user can execute it.
ExecStart=/usr/bin/node %h/.pi-adaptor/current/dist/main.js --home %h/.pi-adaptor --port 19445

Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
