{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-ios.local/contracts/direct-racp-ssh-fallback/1.0.0.schema.json",
  "title": "PI-adaptor Direct RACP and SSH fallback additive contract",
  "description": "Machine-readable wire and configuration shapes from docs/api/direct-racp-ssh-fallback.md. Runtime endpoint, certificate, SSRF, deadline, and routing rules remain normative in that document.",
  "x-contract-version": "direct-racp-ssh-fallback/1.0.0",
  "x-contract-status": "FROZEN",
  "oneOf": [
    {
      "$ref": "#/$defs/directConfigDocument"
    },
    {
      "$ref": "#/$defs/bootstrapTrust"
    },
    {
      "$ref": "#/$defs/providerDiscoverRequest"
    },
    {
      "$ref": "#/$defs/successResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    },
    {
      "$ref": "#/$defs/httpErrorResponse"
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "$ref": "#/$defs/nonEmptyString"
        }
      ]
    },
    "jsonRpc": {
      "const": "2.0"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "hostConfig": {
      "type": "object",
      "description": "Existing host configuration remains open outside the additive direct object. An absent direct property is valid legacy configuration and means direct is disabled; use directConfigDocument when a direct object is required.",
      "properties": {
        "direct": {
          "$ref": "#/$defs/directConfig"
        }
      },
      "additionalProperties": true
    },
    "directConfigDocument": {
      "type": "object",
      "description": "A host configuration document containing the additive direct object.",
      "properties": {
        "direct": {
          "$ref": "#/$defs/directConfig"
        }
      },
      "required": [
        "direct"
      ],
      "additionalProperties": true
    },
    "directConfig": {
      "type": "object",
      "description": "Complete runtime direct.* field set. CLI > PI_ADAPTOR_* env > config.json > defaults. Unknown keys, including bootstrap-only directName, are configuration errors.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "x-env": "PI_ADAPTOR_DIRECT_ENABLED",
          "x-cli": [
            "--direct",
            "--no-direct"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "description": "Explicit local bind address; required when enabled is true.",
          "x-env": "PI_ADAPTOR_DIRECT_HOST",
          "x-cli": "--direct-host"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 9443,
          "x-env": "PI_ADAPTOR_DIRECT_PORT",
          "x-cli": "--direct-port"
        },
        "certificateFile": {
          "type": "string",
          "pattern": "^/",
          "description": "Absolute path to the single self-signed leaf certificate PEM; required when enabled is true.",
          "x-env": "PI_ADAPTOR_DIRECT_CERTIFICATE_FILE",
          "x-cli": "--direct-cert"
        },
        "privateKeyFile": {
          "type": "string",
          "pattern": "^/",
          "description": "Absolute path to the matching private key PEM; required when enabled is true.",
          "x-env": "PI_ADAPTOR_DIRECT_PRIVATE_KEY_FILE",
          "x-cli": "--direct-key"
        },
        "maxConnections": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024,
          "default": 64,
          "x-env": "PI_ADAPTOR_DIRECT_MAX_CONNECTIONS",
          "x-cli": "--direct-max-connections"
        },
        "messageRateCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600,
          "default": 60,
          "x-env": "PI_ADAPTOR_DIRECT_MESSAGE_RATE_COUNT",
          "x-cli": "--direct-message-rate-count"
        },
        "messageRateWindowMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000,
          "default": 10000,
          "x-env": "PI_ADAPTOR_DIRECT_MESSAGE_RATE_WINDOW_MS",
          "x-cli": "--direct-message-rate-window-ms"
        },
        "unauthenticatedTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 30000,
          "default": 10000,
          "x-env": "PI_ADAPTOR_DIRECT_UNAUTHENTICATED_TIMEOUT_MS",
          "x-cli": "--direct-unauthenticated-timeout-ms"
        }
      },
      "required": [],
      "additionalProperties": false,
      "if": {
        "type": "object",
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "host": true,
          "certificateFile": true,
          "privateKeyFile": true
        },
        "required": [
          "host",
          "certificateFile",
          "privateKeyFile"
        ]
      }
    },
    "bootstrapTrust": {
      "type": "object",
      "description": "JSON payload of the independent PI_HOST_DIRECT_TRUST line and the owner-only direct-trust.json file, obtained only over authenticated, host-key-trusted SSH. The line prefix is transport framing and is not part of this JSON value. attemptId must exactly match the current bootstrap attempt; stale attempt files are invalid.",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "attemptId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "hostId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "certificateSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the complete presented leaf certificate DER bytes, stored as lowercase hex."
        },
        "notBefore": {
          "$ref": "#/$defs/timestamp"
        },
        "notAfter": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "schemaVersion",
        "attemptId",
        "hostId",
        "certificateSha256",
        "notBefore",
        "notAfter"
      ],
      "additionalProperties": false
    },
    "result_ping": {
      "type": "object",
      "description": "Authenticated connection/ping result shared by loopback and direct. Direct clients require pong true and a non-empty hostId.",
      "properties": {
        "ok": {
          "const": true
        },
        "serverTime": {
          "$ref": "#/$defs/timestamp"
        },
        "pong": {
          "const": true
        },
        "hostId": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "required": [
        "ok",
        "serverTime",
        "pong",
        "hostId"
      ],
      "additionalProperties": false
    },
    "discoverContext": {
      "type": "object",
      "description": "provider/discover accepts requestId only; idempotencyKey and all other context keys are forbidden.",
      "properties": {
        "requestId": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "required": [
        "requestId"
      ],
      "additionalProperties": false
    },
    "params_providerDiscover": {
      "description": "Exactly one of the saved-provider and ad-hoc request shapes. URL security checks and in-memory-only apiKey handling are specified by DRAFT.3 section 10.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "providerId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "context": {
              "$ref": "#/$defs/discoverContext"
            }
          },
          "required": [
            "providerId"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseUrl": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "apiKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "context": {
              "$ref": "#/$defs/discoverContext"
            }
          },
          "required": [
            "baseUrl",
            "apiKey"
          ]
        }
      ]
    },
    "providerDiscoverRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/jsonRpc"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "method": {
          "const": "provider/discover"
        },
        "params": {
          "$ref": "#/$defs/params_providerDiscover"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    "thinkingLevel": {
      "enum": [
        "off",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "providerModel": {
      "type": "object",
      "description": "Complete legacy ProviderModel. defaultThinkingLevel must be null or a member of thinkingLevels; that cross-field rule is normative prose.",
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "displayName": {
          "type": "string"
        },
        "contextWindow": {
          "type": "integer",
          "minimum": 1
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 1
        },
        "thinkingLevels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/thinkingLevel"
          },
          "uniqueItems": true
        },
        "defaultThinkingLevel": {
          "oneOf": [
            {
              "$ref": "#/$defs/thinkingLevel"
            },
            {
              "type": "null"
            }
          ]
        },
        "supportsImages": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "displayName",
        "contextWindow",
        "maxTokens",
        "thinkingLevels",
        "defaultThinkingLevel",
        "supportsImages"
      ],
      "additionalProperties": false
    },
    "result_providerDiscover": {
      "type": "object",
      "description": "Successful discovery returns one through 500 complete ProviderModel values, with unique ids sorted by id. An empty valid upstream model set is UPSTREAM_RESPONSE_INVALID, not a successful empty result.",
      "properties": {
        "models": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/providerModel"
          }
        }
      },
      "required": [
        "models"
      ],
      "additionalProperties": false
    },
    "successResponse": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/jsonRpc"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/result_ping"
            },
            {
              "$ref": "#/$defs/result_providerDiscover"
            }
          ]
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": false
    },
    "errorData": {
      "type": "object",
      "description": "Non-secret diagnostics only. Upstream response bodies, authorization values, tokens, URLs containing secrets, and apiKey values are forbidden.",
      "properties": {
        "code": {
          "enum": [
            "INTERNAL",
            "UNAUTHORIZED",
            "FORBIDDEN",
            "PROTOCOL_MISMATCH",
            "INVALID_ARGUMENT",
            "NOT_FOUND",
            "CONFLICT",
            "IDEMPOTENCY_CONFLICT",
            "PAYLOAD_TOO_LARGE",
            "PROVIDER_SECRET_MISSING",
            "RATE_LIMITED",
            "ENDPOINT_REJECTED",
            "UPSTREAM_TIMEOUT",
            "UPSTREAM_UNAVAILABLE",
            "UPSTREAM_RESPONSE_INVALID",
            "REDIRECT_FORBIDDEN"
          ]
        },
        "requestId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "field": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "retryAfterMs": {
          "type": "integer",
          "minimum": 0
        },
        "upstreamStatus": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "maxBytes": {
          "const": 2097152
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false
    },
    "racpError": {
      "type": "object",
      "description": "Existing JSON-RPC numeric/business code envelope plus the DRAFT.3 provider discovery codes. Fixed message templates are required; upstream bodies must not be copied.",
      "properties": {
        "code": {
          "enum": [
            -32000,
            -32001,
            -32002,
            -32003,
            -32004,
            -32005,
            -32006,
            -32007,
            -32010,
            -32016,
            -32024,
            -32027,
            -32028,
            -32029,
            -32030,
            -32031
          ]
        },
        "message": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "data": {
          "$ref": "#/$defs/errorData"
        }
      },
      "required": [
        "code",
        "message",
        "data"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "code": {
                "const": -32000
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "INTERNAL"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "code": {
                "const": -32001
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "UNAUTHORIZED"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "code": {
                "const": -32002
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "FORBIDDEN"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "code": {
                "const": -32003
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "PROTOCOL_MISMATCH"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "code": {
                "const": -32004
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "INVALID_ARGUMENT"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "code": {
                "const": -32005
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "NOT_FOUND"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "code": {
                "const": -32006
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "CONFLICT"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "code": {
                "const": -32007
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "IDEMPOTENCY_CONFLICT"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "code": {
                "const": -32010
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "PAYLOAD_TOO_LARGE"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "code": {
                "const": -32016
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "PROVIDER_SECRET_MISSING"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "code": {
                "const": -32024
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "RATE_LIMITED"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "code": {
                "const": -32027
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "ENDPOINT_REJECTED"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "code": {
                "const": -32028
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "UPSTREAM_TIMEOUT"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "code": {
                "const": -32029
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "UPSTREAM_UNAVAILABLE"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "code": {
                "const": -32030
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "UPSTREAM_RESPONSE_INVALID"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "code": {
                "const": -32031
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "REDIRECT_FORBIDDEN"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "errorResponse": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/jsonRpc"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "error": {
          "$ref": "#/$defs/racpError"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "additionalProperties": false
    },
    "httpErrorResponse": {
      "type": "object",
      "description": "Pre-101 direct listener HTTP error body. These are HTTP errors, not WebSocket close frames; no request headers, tokens, secret URL components, private keys, or upstream bodies are allowed.",
      "properties": {
        "code": {
          "enum": [
            "NOT_FOUND",
            "UPGRADE_REQUIRED",
            "PROTOCOL_MISMATCH",
            "UNAUTHORIZED",
            "RATE_LIMITED",
            "INTERNAL",
            "REDIRECT_FORBIDDEN"
          ]
        },
        "requestId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "retryAfterMs": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "required": [
        "code",
        "requestId"
      ],
      "additionalProperties": false
    }
  }
}
