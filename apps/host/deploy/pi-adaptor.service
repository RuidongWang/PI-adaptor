# systemd USER unit for the isolated PI-adaptor host.
#
# Install (do NOT replace any unit that starts the legacy PI-Desktop pi-host):
#   mkdir -p ~/.config/systemd/user
#   cp pi-adaptor.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now pi-adaptor.service
#
# The unit name, env namespace, home, and port are all distinct from the legacy
# host so the two can run side by side with zero shared state.

[Unit]
Description=PI-adaptor (isolated, independent of PI-Desktop pi-host)
After=network.target

[Service]
Type=simple

# Fully isolated root: data/, agent/, logs/, run/ all live below it.
Environment=PI_ADAPTOR_HOME=%h/.pi-adaptor
Environment=PI_ADAPTOR_PORT=19445

# Absolute path to the built entrypoint for the deployed version.
ExecStart=/usr/bin/node %h/.pi-adaptor/current/dist/main.js --home %h/.pi-adaptor --port 19445

Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
